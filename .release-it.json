{
  "git": {
    "requireCleanWorkingDir": false
  },
  "hooks": {
    "before:init": ["pnpm test"],
    "after:init": ["t2k"],
    "after:bump": ["pnpm build"],
    "after:release": ["yarn pkg get name | cnpm sync"]
  },
  "github": {
    "release": true,
    "proxy": "http://127.0.0.1:9090"
  }
}
